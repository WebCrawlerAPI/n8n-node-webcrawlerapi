{
  "name": "n8n-nodes-webcrawlerapi",
  "version": "0.3.0",
  "description": "n8n node for WebCrawler API integration - a website to markdown API for LLM and RAG",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "webcrawler",
    "webcrawlerapi",
    "scraping",
    "api",
    "webcrawling",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://webcrawlerapi.com",
  "author": {
    "name": "WebCrawler API",
    "email": "support@webcrawlerapi.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WebCrawlerAPI/n8n-node-webcrawlerapi.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && eslint --config eslint.config.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WebCrawlerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WebCrawlerApi/WebCrawlerApiNode.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.6",
    "gulp": "^5.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "2.20.0"
  }
}
